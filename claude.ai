    <!-- Footer -->
    <footer
        class="w-full py-12 px-8 flex flex-col md:flex-row justify-between items-center gap-6 bg-stone-50 dark:bg-stone-950 border-t border-stone-200 dark:border-stone-800">
        <div class="flex flex-col items-center md:items-start gap-2">
            <span class="text-lg font-bold text-stone-800 dark:text-stone-200 font-['Newsreader']">Ruchi Rush</span>
            <span class="text-stone-500 dark:text-stone-400 font-['Newsreader'] text-sm">© 2026 Ruchi Rush. Made with
                love.</span>
        </div>
        <div class="flex gap-8">
            <a class="text-stone-500 dark:text-stone-400 font-['Newsreader'] text-sm hover:text-orange-500 transition-colors"
                href="#">About Us</a>
            <a class="text-stone-500 dark:text-stone-400 font-['Newsreader'] text-sm hover:text-orange-500 transition-colors"
                href="#">Privacy Policy</a>
            <a class="text-stone-500 dark:text-stone-400 font-['Newsreader'] text-sm hover:text-orange-500 transition-colors"
                href="#">Terms of Service</a>
            <a class="text-stone-500 dark:text-stone-400 font-['Newsreader'] text-sm hover:text-orange-500 transition-colors"
                href="#">Contact</a>
        </div>
    </footer>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    <script>
        gsap.registerPlugin(ScrollTrigger);
 
        gsap.from(".nav-anim", {
            y: -80,
            opacity: 0,
            duration: 1,
            ease: "power3.out",
            clearProps: "all"
        });
 
        gsap.from(".left-text", {
            x: -150,
            opacity: 0,
            duration: 1
        });
 
        gsap.from(".right-text", {
            x: 150,
            opacity: 0,
            duration: 1
        });
 
        gsap.from(".center-text", {
            scale: 0.5,
            opacity: 0,
            duration: 0.8,
            delay: 0.5
        });
 
        const hero = document.querySelector(".hero-bg");
 
        hero.addEventListener("mousemove", (e) => {
            let x = (e.clientX / window.innerWidth - 0.5) * 20;
            let y = (e.clientY / window.innerHeight - 0.5) * 20;
 
            gsap.fromTo(hero, {
                backgroundPosition: `${50 + x}% ${50 + y}%`,
                duration: 0.5
            });
        });
 
        gsap.from(".why-left", {
            x: -100,
            opacity: 0,
            duration: 1,
            scrollTrigger: {
                trigger: ".why-left",
                start: "top 80%",
                toggleActions: "play reverse play reverse"
            }
        });
 
        gsap.from(".why-right", {
            x: 100,
            opacity: 0,
            duration: 1,
            scrollTrigger: {
                trigger: ".why-right",
                start: "top 80%",
                toggleActions: "play reverse play reverse"
            }
        });
        gsap.from(".offer-card", {
            y: 60,
            opacity: 0,
            stagger: 0.2,
            duration: 1,
            scrollTrigger: {
                trigger: ".offer-card",
                start: "top 85%",
                toggleActions: "play reverse play reverse"
            }
        });
        gsap.from(".step-item", {
            y: 40,
            opacity: 0,
            stagger: 0.3,
            duration: 1,
            scrollTrigger: {
                trigger: ".step-item",
                start: "top 85%",
                toggleActions: "play reverse play reverse"
            }
        });
        gsap.fromTo(".step-row",
            { y: 40, opacity: 0 },
            {
                y: 0,
                opacity: 1,
                stagger: 0.2,
                scrollTrigger: {
                    trigger: ".step-row",
                    start: "top 90%",
                    toggleActions: "play reverse play reverse"
                }
            }
        );
    </script>
    <!-- ============================================================
         COOKIE / PRIVACY BANNER
    ============================================================ -->
    <div id="cookieBanner"
        class="fixed bottom-0 left-0 right-0 z-[99998] transform translate-y-full transition-transform duration-500 ease-out"
        style="display:none">
        <div class="bg-on-surface text-surface mx-4 mb-4 rounded-xl shadow-2xl p-md flex flex-col sm:flex-row items-center justify-between gap-md border border-white/10">
            <div class="flex items-start gap-sm flex-1">
                <span class="text-2xl shrink-0">🍪</span>
                <p class="font-body-md text-sm text-surface/80">
                    We use cookies to improve your experience and analyze site traffic. By continuing, you agree to our
                    <a href="#" class="underline text-primary-fixed-dim hover:text-primary-container">Privacy Policy</a>.
                </p>
            </div>
            <div class="flex gap-sm shrink-0">
                <button id="cookieDecline"
                    class="px-md py-xs rounded-full text-sm border border-white/20 text-surface/70 hover:text-surface transition-colors">
                    Decline
                </button>
                <button id="cookieAccept"
                    class="px-md py-xs rounded-full text-sm bg-primary text-on-primary font-semibold hover:scale-105 active:scale-95 transition-transform">
                    Accept All
                </button>
            </div>
        </div>
    </div>
 
    <script>
        // ── Cookie Banner ────────────────────────────────────────
        (function() {
            const consent = localStorage.getItem("rr_cookie_consent");
            if (!consent) {
                const banner = document.getElementById("cookieBanner");
                banner.style.display = "block";
                // Animate in after a short delay
                setTimeout(() => {
                    banner.style.transform = "translateY(0)";
                }, 500);
            }
 
            document.getElementById("cookieAccept")?.addEventListener("click", () => {
                localStorage.setItem("rr_cookie_consent", "accepted");
                hideBanner();
            });
            document.getElementById("cookieDecline")?.addEventListener("click", () => {
                localStorage.setItem("rr_cookie_consent", "declined");
                hideBanner();
            });
 
            function hideBanner() {
                const banner = document.getElementById("cookieBanner");
                banner.style.transform = "translateY(120%)";
                setTimeout(() => banner.style.display = "none", 500);
            }
        })();
 
        // ── Active Nav Highlight on Scroll ───────────────────────
        (function() {
            const sections = [
                { id: "hero",          link: 'a[href="#hero"]' },
                { id: "why-us",        link: 'a[href="#why-us"]' },
                { id: "what-we-offer", link: 'a[href="#what-we-offer"]' },
                { id: "how-it-works",  link: 'a[href="#how-it-works"]' },
                { id: "contact",       link: 'a[href="#contact"]' },
            ];
 
            const activeClass = ["text-orange-600", "font-semibold"];
            const inactiveClass = ["text-stone-700"];
 
            function setActive(id) {
                sections.forEach(({ id: sid, link }) => {
                    const el = document.querySelector(link);
                    if (!el) return;
                    if (sid === id) {
                        el.classList.add(...activeClass);
                        el.classList.remove(...inactiveClass);
                    } else {
                        el.classList.remove(...activeClass);
                        el.classList.add(...inactiveClass);
                    }
                });
            }
 
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) setActive(entry.target.id);
                });
            }, { rootMargin: "-40% 0px -55% 0px" });
 
            sections.forEach(({ id }) => {
                const el = document.getElementById(id);
                if (el) observer.observe(el);
            });
        })();
 
        // ── Smooth scroll offset for fixed header ────────────────
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener("click", function(e) {
                const target = document.querySelector(this.getAttribute("href"));
                if (!target) return;
                e.preventDefault();
                const offset = 80; // header height
                const top = target.getBoundingClientRect().top + window.scrollY - offset;
                window.scrollTo({ top, behavior: "smooth" });
            });
        });
    </script>
</body>
        const menuBtn = document.getElementById("menuBtn");
        const menu = document.getElementById("mobileMenu");
 
        menuBtn.addEventListener("click", () => { menu.style.right = "0"; });
        function closeMenu() { menu.style.right = "-100%"; }
        menu.addEventListener("click", () => { menu.style.right = "-100%"; });
 
        // ── Waitlist Modal ───────────────────────────────────────
        const modal = document.getElementById("waitlistModal");
 
        function openWaitlist(role) {
            modal.style.display = "flex";
            document.body.style.overflow = "hidden";
            if (role) {
                const radio = modal.querySelector(`input[value="${role}"]`);
                if (radio) radio.checked = true;
            }
            // Animate in
            modal.querySelector('.relative.bg-surface').style.transform = "scale(0.95)";
            modal.querySelector('.relative.bg-surface').style.opacity = "0";
            requestAnimationFrame(() => {
                modal.querySelector('.relative.bg-surface').style.transition = "all 0.25s ease";
                modal.querySelector('.relative.bg-surface').style.transform = "scale(1)";
                modal.querySelector('.relative.bg-surface').style.opacity = "1";
            });
        }
 
        function closeWaitlist() {
            modal.style.display = "none";
            document.body.style.overflow = "";
        }
 
        document.getElementById("closeModal").addEventListener("click", closeWaitlist);
        document.getElementById("modalBackdrop").addEventListener("click", closeWaitlist);
        document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeWaitlist(); });
 
        // Auto-open popup after 8 seconds (first visit only)
        if (!sessionStorage.getItem("waitlistSeen")) {
            setTimeout(() => {
                openWaitlist(null);
                sessionStorage.setItem("waitlistSeen", "1");
            }, 8000);
        }
 
        // ── Waitlist Form Submit (AJAX) ───────────────────────────
        document.getElementById("waitlistForm").addEventListener("submit", async function(e) {
            e.preventDefault();
            const btn = this.querySelector("button[type=submit]");
            btn.textContent = "Joining...";
            btn.disabled = true;
            try {
                const res = await fetch(this.action, {
                    method: "POST",
                    body: new FormData(this),
                    headers: { "Accept": "application/json" }
                });
                if (res.ok) {
                    document.getElementById("waitlistSuccess").classList.remove("hidden");
                    this.querySelectorAll("input,textarea,button").forEach(el => el.style.display = "none");
                    setTimeout(closeWaitlist, 3000);
                } else {
                    btn.textContent = "Try Again";
                    btn.disabled = false;
                }
            } catch {
                btn.textContent = "Try Again";
                btn.disabled = false;
            }
        });
 
        // ── Contact Form Submit (AJAX) ────────────────────────────
        document.getElementById("contactForm").addEventListener("submit", async function(e) {
            e.preventDefault();
            const btn = document.getElementById("submitBtn");
            document.getElementById("submitText").textContent = "Sending...";
            document.getElementById("submitSpinner").classList.remove("hidden");
            btn.disabled = true;
            document.getElementById("formSuccess").classList.add("hidden");
            document.getElementById("formError").classList.add("hidden");
            try {
                const res = await fetch(this.action, {
                    method: "POST",
                    body: new FormData(this),
                    headers: { "Accept": "application/json" }
                });
                if (res.ok) {
                    document.getElementById("formSuccess").classList.remove("hidden");
                    this.reset();
                } else {
                    document.getElementById("formError").classList.remove("hidden");
                }
            } catch {
                document.getElementById("formError").classList.remove("hidden");
            } finally {
                document.getElementById("submitText").textContent = "Send Message";
                document.getElementById("submitSpinner").classList.add("hidden");
                btn.disabled = false;
            }
        });
 
        // ── WhatsApp FAB: hide on scroll up, show on scroll down ─
        let lastScroll = 0;
        const fab = document.getElementById("whatsappFab");
        window.addEventListener("scroll", () => {
            const curr = window.scrollY;
            fab.style.transform = curr < 100 ? "scale(1)" : curr > lastScroll ? "scale(0.85)" : "scale(1)";
            lastScroll = curr;
        });
    </script>
</body>
 
</html>
 
