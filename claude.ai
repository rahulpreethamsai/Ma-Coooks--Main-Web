    <div class="fixed inset-0 grain-texture z-0 pointer-events-none"></div>
    <!-- Navigation Header -->
    <header
        class="nav-anim fixed top-0 left-0 w-full z-[9999] flex justify-between items-center px-6 py-4 mx-auto backdrop-filter backdrop-blur-lg">
        <div class="flex items-center gap-2">
            <span class="material-symbols-outlined text-orange-500 dark:text-orange-400"
                data-icon="restaurant">restaurant</span>
            <span
                class="text-2xl font-bold text-orange-600 dark:text-orange-400 tracking-tight font-['Newsreader']">Ruchi
                Rush</span>
        </div>
        <nav class="hidden md:flex gap-8 items-center">
            <a class="nav-link text-orange-600 dark:text-orange-400 font-semibold font-['Newsreader'] transition-opacity hover:opacity-80" href="#hero">Home</a>
            <a class="nav-link text-stone-700 dark:text-stone-300 font-['Newsreader'] transition-opacity hover:opacity-80" href="#why-us">Why Us</a>
            <a class="nav-link text-stone-700 dark:text-stone-300 font-['Newsreader'] transition-opacity hover:opacity-80" href="#what-we-offer">Explore</a>
            <a class="nav-link text-stone-700 dark:text-stone-300 font-['Newsreader'] transition-opacity hover:opacity-80" href="#contact">Contact</a>
            <button onclick="openWaitlist('chef')"
                class="relative overflow-hidden bg-primary-container text-white px-6 py-2 rounded-full font-label-sm scale-95 active:scale-90 transition-transform duration-200 group">
                <img src="https://media1.giphy.com/media/v1.Y2lkPTc5MGI3NjExbmVmOTRnOXY3aWpnMGhkeGw5aTN6ejAzcGZxNWdiaHdxOTJheW51eiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/YoKaNSoTHog8Y3550r/giphy.gif"
                    class="absolute inset-0 w-full h-full object-contain object-center opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
                <span class="relative z-10">Join as Chef</span>
            </button>
        </nav>
        <button id="menuBtn" class="md:hidden text-3xl">
            ☰
        </button>
        <div id="mobileMenu"
            class="fixed top-0 right-[-100%] w-[100%] h-full transition-all duration-300 z-50">
 
            <button onclick="closeMenu()" class="text-2xl pt-5"
                onclick="document.getElementById('mobileMenu').style.right='-100%'">
                ✕
            </button>
 
            <div class="flex flex-col gap-6 p-10 text-lg text-white bg-black/60 backdrop-blur-lg">
                <a href="#hero" onclick="closeMenu()" class="hover:underline">Home</a>
                <a href="#why-us" onclick="closeMenu()" class="hover:underline">Why Us</a>
                <a href="#what-we-offer" onclick="closeMenu()" class="hover:underline">What We Offer</a>
                <a href="#how-it-works" onclick="closeMenu()" class="hover:underline">How It Works</a>
                <a href="#contact" onclick="closeMenu()" class="hover:underline">Contact</a>
            </div>
        </div>
    </header>
    <main>
        <!-- Section 1: HERO -->
        <section id="hero"
            class="hero-gradient hero-bg min-h-screen pt-28 pb-lg px-6 flex flex-col items-center justify-center text-center">
            <div class="max-w-4xl mx-auto">
                <h1 class="hero-title text-6xl font-semibold font-[Solway, serif]">
                    <span class="left-text">From Home</span>
                    <span class="center-text">Kitchens</span>
                    <span class="right-text">to Your Home</span>
                </h1>
                <p class="font-body-lg text-body-lg text-on-surface-variant mb-lg max-w-2xl mx-auto mt-10">
                    Not restaurant food. Real home food made by real people. Experience the warmth of a kitchen that
                    cares.
                </p>
                <div class="flex flex-col sm:flex-row gap-md justify-center">
                    <div class="flex flex-row items-center justify-between">
                        <button onclick="openWaitlist('customer')"
                            class="flex items-center gap-2 bg-primary px-lg py-md rounded-full text-on-primary font-h3 transition-transform hover:scale-105 active:scale-95 shadow-md">
                            I WANT TO EAT
                            <img src="https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExa3J1N3o2cmE0YWkxNXF5NGFwNmF1eHM4ZHJ5NTF0dGxpajkzMHBxayZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/jUuhj2J2sYgV7VsW5h/giphy.gif"
                                width="30" height="30" class="brightness-0 invert" />
                        </button>
                    </div>
                    <div class="flex flex-row items-center justify-between">
                        <button onclick="openWaitlist('chef')"
                            class="flex items-center gap-2 bg-surface-container-highest px-lg py-md rounded-full text-primary font-h3 border-2 border-primary/10 transition-transform hover:scale-105 active:scale-95">
                            I WANT TO COOK
                            <img src="https://media0.giphy.com/media/v1.Y2lkPTc5MGI3NjExaG44YWZta2l3bWNzeGxxMmh3aHRvOTdneDR3YXRqaDJ1MGlrbzAzdiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9cw/SJJhxzipvPyi5zyOvT/giphy.gif"
                                width="30" height="30" />
                        </button>
                    </div>
                </div>
            </div>
            <div class="mt-lg w-full max-w-5xl overflow-hidden rounded-xl shadow-2xl">
                <img class="w-full h-[400px] object-cover"
                    alt="Warm and cozy home kitchen with steam rising from a pot, natural sunlight streaming through a window onto a rustic wooden table"
                    src="https://lh3.googleusercontent.com/aida-public/AB6AXuDkdvd4kzyYPF7HoCtBJcSKJlhsHkcwhER5NvSsI5eb5psiVv8oth_uUrelBEm-iH9KGg1epV6DW5opg_Gy8lTsBqnipv52d3h2wupeo1qnQUcR7t6ZUwXIlwmJZcix7kKgd_M07dl4jTrG-P4e-02VdwzdCMt3lURb7JHwpYSxKImPWe8jOW6JUDkbP6DxY9qomCg-Ow--E6Gu2Ks9lgllEHznSenPK1H17F8ESrlpe16f4ofFcEsphw9gJoTCY6mfC9lrlh0cmF44" />
            </div>
        </section>
        <!-- Section 2: STORYTELLING SCROLL -->
        <section class="py-xl px-6 bg-on-surface text-surface text-center overflow-hidden">
            <div class="max-w-3xl mx-auto flex flex-col items-center">
                <div class="mb-lg relative w-32 h-32">
                    <svg class="w-full h-full text-primary-container fill-current animate-pulse" viewbox="0 0 100 100">
                        <path d="M50 5 C50 5 80 40 80 65 C80 85 65 95 50 95 C35 95 20 85 20 65 C20 40 50 5 50 5 Z">
                        </path>
                        <path class="opacity-50"
                            d="M50 25 C50 25 70 50 70 70 C70 80 60 90 50 90 C40 90 30 80 30 70 C30 50 50 25 50 25 Z">
                        </path>
                    </svg>
                </div>
                <h2 class="font-h2 text-h2 mb-md italic">Cooking began with fire.</h2>
                <p class="font-h3 text-h3 text-surface-variant">Today, it lives in our homes.</p>
            </div>
        </section>
        <!-- Section 3: WHY US (Comparison) -->
        <section id="why-us" class="py-xl px-6 max-w-7xl mx-auto">
            <h2 class="font-h2 text-h2 text-center mb-lg">Why choose Ruchi Rush?</h2>
            <div class="grid md:grid-cols-2 gap-lg">
                <!-- Other Apps -->
                <div
                    class="why-left bg-surface-container-low p-lg rounded-lg border border-outline-variant/30 flex flex-col gap-md opacity-70 grayscale">
                    <h3 class="font-h3 text-h3">Other Apps</h3>
                    <ul class="space-y-sm">
                        <li class="flex items-center gap-xs font-body-md">
                            <span class="material-symbols-outlined text-error" data-icon="close">close</span>
                            High 30% commission per order
                        </li>
                        <li class="flex items-center gap-xs font-body-md">
                            <span class="material-symbols-outlined text-error" data-icon="close">close</span>
                            Industrial kitchen mass production
                        </li>
                        <li class="flex items-center gap-xs font-body-md">
                            <span class="material-symbols-outlined text-error" data-icon="close">close</span>
                            Anonymous, transactional experience
                        </li>
                    </ul>
                </div>
                <!-- Ruchi Rush -->
                <div
                    class="why-right bg-surface-container-high p-lg rounded-lg border-2 border-primary/20 shadow-lg flex flex-col gap-md">
                    <div class="flex justify-between items-start">
                        <h3 class="font-h3 text-h3 text-primary">Ruchi Rush</h3>
                        <span
                            class="bg-primary text-on-primary px-sm py-xs rounded-full text-label-sm">RECOMMENDED</span>
                    </div>
                    <ul class="space-y-sm">
                        <li class="flex items-center gap-xs font-body-md font-semibold">
                            <span class="material-symbols-outlined text-primary" data-icon="check">check</span>
                            Low 8% commission — Chefs keep more
                        </li>
                        <li class="flex items-center gap-xs font-body-md font-semibold">
                            <span class="material-symbols-outlined text-primary" data-icon="check">check</span>
                            Real homemade food, small batches
                        </li>
                        <li class="flex items-center gap-xs font-body-md font-semibold">
                            <span class="material-symbols-outlined text-primary" data-icon="check">check</span>
                            Human stories behind every recipe
                        </li>
                    </ul>
                </div>
            </div>
        </section>
        <!-- Section 4: WHAT WE OFFER (Bento Grid) -->
        <section id="what-we-offer" class="py-xl bg-surface-container-low px-6">
            <div class="offer-card max-w-7xl mx-auto">
                <h2 class="font-h2 text-h2 text-center mb-lg">What we offer</h2>
                <div class="grid grid-cols-1 md:grid-cols-4 md:grid-rows-2 gap-md h-auto md:h-[600px]">
                    <div
                        class="md:col-span-2 md:row-span-2 bg-surface rounded-lg p-md overflow-hidden flex flex-col shadow-sm group">
                        <img class="w-full h-2/3 object-cover rounded-md mb-md transition-transform group-hover:scale-105"
                            alt="Top-down view of several ceramic bowls filled with colorful home-cooked stews and salads on a linen tablecloth"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDvpNdN_OEYraBwPEOYjDtuFWDKIT5t2oQT3bYjb_Uglbld5qrQqwF5tUU0GZM_FH0buScpefsLKaie7hbFIX2eX-ogVNICLHunBp6BZnoLR8iz5AArKm7euBu3fFdo0ZJlWwdXy_xg8V_FbhM5NaLr5de-AzAbK_AhinpsyLndq0fouVzRm5afs2BZEwvGeCnzvrvbr_z8-A6oBRD4anMigyWInvzksDAZQYRWpsG8rGMjDDQJWooDg8MXORHhTwtfEAYY32zG1yba" />
                        <h3 class="font-h3 text-h3 mb-xs">Pre-order meals</h3>
                        <p class="font-body-md text-on-surface-variant">Reserve authentic dishes 24h in advance for peak
                            freshness.</p>
                    </div>
                    <div class="md:col-span-2 bg-secondary-container rounded-lg p-md flex items-center justify-between">
                        <div>
                            <h3 class="font-h3 text-h3 mb-xs text-on-secondary-container">Office meal plans</h3>
                            <p class="font-body-md text-on-secondary-variant">Bring home-cooked warmth to your workspace
                                lunch.</p>
                        </div>
                        <span class="material-symbols-outlined text-4xl text-on-secondary-container"
                            data-icon="corporate_fare">corporate_fare</span>
                    </div>
                    <div
                        class="bg-primary-container rounded-lg p-md flex flex-col justify-end text-on-primary-container">
                        <span class="material-symbols-outlined text-3xl mb-sm" data-icon="groups">groups</span>
                        <h3 class="font-label-sm font-bold uppercase mb-xs">Community Circles</h3>
                        <p class="text-sm">Join local food swaps.</p>
                    </div>
                    <div class="bg-surface rounded-lg p-md border border-outline-variant/20 flex flex-col justify-end">
                        <img class="w-12 h-12 rounded-full object-cover mb-sm"
                            alt="Smiling middle-aged woman in a clean apron holding a rolling pin in a bright kitchen"
                            src="https://lh3.googleusercontent.com/aida-public/AB6AXuABSrnTvbFreixjqy14ilrZVwk8pU-8UX4aw6r3BQbzbAJhPYTJhXKHYmPF92uoMzAfO_6-JuB7d-BGgsmOCelwl9oGflzmoX7p9zJ1GuLLwS9NHU3vaK0H9gpEqOXtuH_dE1c-uWom71xSfiNmlcemfYPzm-aVT1b2V640If-rs6j6lipCgwedmNPTIl9KVPDg2C2ihzQgLWMdHB6i0ny13z50splL2fq2RTqw6AZokG77xJflRHGuw3TDVVPeQuHz7OyywMSQn6xh" />
                        <h3 class="font-label-sm font-bold uppercase mb-xs">Chef Profiles</h3>
                        <p class="text-sm">Meet the hands that cook.</p>
                    </div>
                </div>
            </div>
        </section>
        <!-- Section 5: TRUST SECTION -->
        <section class="py-xl px-6 text-center max-w-4xl mx-auto">
            <h2 class="font-h2 text-h2 mb-md">Transparency You Can Feel</h2>
            <p class="font-body-lg text-on-surface-variant mb-lg">We don't just vet the food; we know the people. Every
                kitchen is inspected and every chef is verified.</p>
            <div class="flex flex-wrap justify-center gap-md">
                <div class="flex items-center gap-xs bg-surface-container-highest px-md py-sm rounded-full">
                    <span class="material-symbols-outlined text-primary" data-icon="verified_user">verified_user</span>
                    <span class="font-label-sm">Inspected Kitchens</span>
                </div>
                <div class="flex items-center gap-xs bg-surface-container-highest px-md py-sm rounded-full">
                    <span class="material-symbols-outlined text-primary"
                        data-icon="health_and_safety">health_and_safety</span>
                    <span class="font-label-sm">Hygiene Certified</span>
                </div>
                <div class="flex items-center gap-xs bg-surface-container-highest px-md py-sm rounded-full">
                    <span class="material-symbols-outlined text-primary" data-icon="contact_page">contact_page</span>
                    <span class="font-label-sm">Identity Verified</span>
                </div>
            </div>
        </section>
        <!-- Section 6: HOW IT WORKS -->
        <section id="how-it-works" class="py-xl px-6 bg-surface-container-low">
            <div class="max-w-7xl mx-auto">
                <div class="flex flex-col md:flex-row justify-between items-center">
                    <div class="step-item">
                        <h2 class="font-h2 text-h2 mb-lg">For the Hungry</h2>
                        <div class="space-y-md">
                            <div class="step-row flex gap-md">
                                <span
                                    class="bg-primary-container text-on-primary-container w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">1</span>
                                <div>
                                    <h4 class="font-h3 text-xl mb-xs">Browse Local Chefs</h4>
                                    <p class="font-body-md text-on-surface-variant">Find neighbors who are cooking
                                        something delicious today.</p>
                                </div>
                            </div>
                            <div class="step-row flex gap-md">
                                <span
                                    class="bg-primary-container text-on-primary-container w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">2</span>
                                <div>
                                    <h4 class="font-h3 text-xl mb-xs">Pick a Time</h4>
                                    <p class="font-body-md text-on-surface-variant">Pre-order for pickup or local
                                        delivery at your convenience.</p>
                                </div>
                            </div>
                            <div class="step-row flex gap-md">
                                <span
                                    class="bg-primary-container text-on-primary-container w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">3</span>
                                <div>
                                    <h4 class="font-h3 text-xl mb-xs">Enjoy Real Food</h4>
                                    <p class="font-body-md text-on-surface-variant">Eat like you're part of the family,
                                        because you are.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="step-item">
                        <h2 class="font-h2 text-h2 mb-lg">For the Cooks</h2>
                        <div class="space-y-md">
                            <div class="step-row flex gap-md">
                                <span
                                    class="bg-secondary-container text-on-secondary-container w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">1</span>
                                <div>
                                    <h4 class="font-h3 text-xl mb-xs">Set Your Menu</h4>
                                    <p class="font-body-md text-on-surface-variant">Cook what you love, when you want to
                                        cook it.</p>
                                </div>
                            </div>
                            <div class="step-row flex gap-md">
                                <span
                                    class="bg-secondary-container text-on-secondary-container w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">2</span>
                                <div>
                                    <h4 class="font-h3 text-xl mb-xs">Pass Inspection</h4>
                                    <p class="font-body-md text-on-surface-variant">We'll help you get your kitchen
                                        certified for safety.</p>
                                </div>
                            </div>
                            <div class="step-row flex gap-md">
                                <span
                                    class="bg-secondary-container text-on-secondary-container w-10 h-10 rounded-full flex items-center justify-center shrink-0 font-bold">3</span>
                                <div>
                                    <h4 class="font-h3 text-xl mb-xs">Earn Fairly</h4>
                                    <p class="font-body-md text-on-surface-variant">Take home 92% of every meal you
                                        sell. No hidden fees.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <!-- Section 7: EMOTIONAL BLOCK (Parallax Feel) -->
        <section class="relative h-[530px] flex items-center justify-center overflow-hidden">
            <img class="absolute inset-0 w-full h-full object-cover scale-110"
                alt="Dramatic lighting on a table spread with mediterranean dishes, olives, fresh bread, and wine"
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDyY5IZ9om0T4IR6jkvrPFILPh73j3D4C5P_8ZWuau3nJ6TGPkg1HBQx_XAw58RmI0Css-IuPkJcHvhKthvIA1fXEq4mUNnBrlo0zIaP2y2BkNynDAScUmaS0FzpxrIfaD7QNBQaagvDI8oJF-Ksq9fK_BUIgv47ILF3YSTDJFHxTq-IPhB-YPdU40Fgu55bhp4I8b_ls8ZvJoNJK-FRSLH0rRWmaLSkndpBsGBekJcub2kCARSxCVgqGbCj06WBgjoW3HI3S0M86eY" />
            <div class="absolute inset-0 bg-on-surface/40 backdrop-blur-[2px]"></div>
            <div class="relative z-10 text-center text-surface px-6 max-w-2xl">
                <blockquote class="font-h1 text-h2 italic mb-md">"Food is not just eaten. It is felt."</blockquote>
                <p class="font-label-sm tracking-widest uppercase">— THE RUCHI RUSH PHILOSOPHY</p>
            </div>
        </section>
        <!-- Section 8: CTA SECTION -->
        <section class="py-xl px-6 bg-surface-container text-center">
            <div class="max-w-3xl mx-auto">
                <h2 class="font-h2 text-h2 mb-md">Ready to be part of something real?</h2>
                <p class="font-body-lg text-on-surface-variant mb-lg">Join thousands of neighbors rediscovering the
                    magic of a home-cooked meal.</p>
                <div class="flex flex-col sm:flex-row gap-md justify-center">
                    <button onclick="openWaitlist('customer')"
                        class="bg-primary text-on-primary px-lg py-md rounded-full font-h3 transition-transform hover:scale-105 active:scale-95 shadow-lg">Start
                        Eating</button>
                    <button onclick="openWaitlist('chef')"
                        class="bg-on-surface text-surface px-lg py-md rounded-full font-h3 transition-transform hover:scale-105 active:scale-95">Open
                        Your Kitchen</button>
                </div>
            </div>
        </section>
        <!-- Section 9: CONTACT -->
        <section id="contact" class="py-xl px-6 max-w-7xl mx-auto">
            <div class="grid md:grid-cols-2 gap-xl bg-surface rounded-xl overflow-hidden border border-outline-variant/30">
                <div class="p-lg bg-surface-container-low flex flex-col justify-between">
                    <div>
                        <h2 class="font-h2 text-h2 mb-sm text-primary">Get in touch</h2>
                        <p class="font-body-md text-on-surface-variant">Have questions about becoming a chef or a
                            customer? We're here to chat.</p>
                    </div>
                    <div class="space-y-sm mt-lg">
                        <div class="flex items-center gap-sm">
                            <span class="material-symbols-outlined text-primary">mail</span>
                            <span class="font-body-md">hello@ruchirush.com</span>
                        </div>
                        <div class="flex items-center gap-sm">
                            <span class="material-symbols-outlined text-primary">location_on</span>
                            <span class="font-body-md">Hyderabad, Telangana</span>
                        </div>
                        <!-- WhatsApp quick contact -->
                        <a href="https://wa.me/919999999999?text=Hi%20Ruchi%20Rush!%20I%20have%20a%20question."
                           target="_blank"
                           class="flex items-center gap-sm mt-md bg-[#25D366] text-white px-md py-sm rounded-full w-fit transition-transform hover:scale-105 active:scale-95 shadow-md">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="white">
                                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                            </svg>
                            Chat on WhatsApp
                        </a>
                    </div>
                </div>
 
                <!-- Formspree Form — replace YOUR_FORM_ID with your actual Formspree ID from formspree.io -->
                <form id="contactForm" action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="p-lg space-y-md">
                    <div class="grid grid-cols-2 gap-md">
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-sm uppercase" for="firstName">First Name</label>
                            <input id="firstName" name="firstName"
                                class="w-full bg-surface-container-low border border-outline-variant/30 rounded-full px-md py-sm focus:outline-none focus:ring-2 focus:ring-primary"
                                placeholder="Jane" type="text" required />
                        </div>
                        <div class="flex flex-col gap-xs">
                            <label class="font-label-sm uppercase" for="lastName">Last Name</label>
                            <input id="lastName" name="lastName"
                                class="w-full bg-surface-container-low border border-outline-variant/30 rounded-full px-md py-sm focus:outline-none focus:ring-2 focus:ring-primary"
                                placeholder="Doe" type="text" required />
                        </div>
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-sm uppercase" for="email">Email Address</label>
                        <input id="email" name="email"
                            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-full px-md py-sm focus:outline-none focus:ring-2 focus:ring-primary"
                            placeholder="jane@example.com" type="email" required />
                    </div>
                    <div class="flex flex-col gap-xs">
                        <label class="font-label-sm uppercase" for="message">Message</label>
                        <textarea id="message" name="message"
                            class="w-full bg-surface-container-low border border-outline-variant/30 rounded-lg px-md py-sm focus:outline-none focus:ring-2 focus:ring-primary"
                            placeholder="Tell us what's on your mind..." rows="4" required></textarea>
                    </div>
                    <!-- Honeypot spam filter -->
                    <input type="text" name="_gotcha" style="display:none" />
                    <input type="hidden" name="_subject" value="New message from Ruchi Rush website!" />
 
                    <button id="submitBtn" type="submit"
                        class="w-full bg-primary text-on-primary py-md rounded-full font-h3 transition-transform active:scale-95 hover:scale-[1.02] flex items-center justify-center gap-2">
                        <span id="submitText">Send Message</span>
                        <span id="submitSpinner" class="hidden">
                            <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="white" stroke-width="4"></circle>
                                <path class="opacity-75" fill="white" d="M4 12a8 8 0 018-8v8z"></path>
                            </svg>
                        </span>
                    </button>
 
                    <!-- Success / Error messages -->
                    <div id="formSuccess" class="hidden text-center py-sm px-md bg-green-100 text-green-800 rounded-xl font-body-md">
                        ✅ Message sent! We'll reply within 24 hours.
                    </div>
                    <div id="formError" class="hidden text-center py-sm px-md bg-red-100 text-red-800 rounded-xl font-body-md">
                        ❌ Something went wrong. Please try again or WhatsApp us.
                    </div>
                </form>
            </div>
        </section>
    </main>
 
    <!-- ============================================================
         WAITLIST POPUP MODAL
    ============================================================ -->
    <div id="waitlistModal" class="fixed inset-0 z-[99999] flex items-center justify-center p-4" style="display:none !important">
        <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="modalBackdrop"></div>
        <div class="relative bg-surface rounded-xl shadow-2xl max-w-md w-full p-lg z-10 border border-outline-variant/30">
            <button id="closeModal" class="absolute top-4 right-4 text-on-surface-variant hover:text-on-surface text-2xl leading-none">✕</button>
            <div class="text-center mb-md">
                <div class="text-4xl mb-sm">🍲</div>
                <h3 class="font-h2 text-h2 text-primary mb-xs">Join the Waitlist</h3>
                <p class="font-body-md text-on-surface-variant">Be the first to know when Ruchi Rush launches in your area. Early members get <strong>free delivery for a month!</strong></p>
            </div>
            <form id="waitlistForm" action="https://formspree.io/f/YOUR_FORM_ID" method="POST" class="space-y-md">
                <input type="hidden" name="_subject" value="New Waitlist Signup — Ruchi Rush!" />
                <input type="hidden" name="type" value="waitlist" />
                <input type="text" name="_gotcha" style="display:none" />
                <div class="flex flex-col gap-xs">
                    <label class="font-label-sm uppercase">Your Name</label>
                    <input name="name" type="text" placeholder="Priya Sharma"
                        class="w-full bg-surface-container-low border border-outline-variant/30 rounded-full px-md py-sm focus:outline-none focus:ring-2 focus:ring-primary"
                        required />
                </div>
                <div class="flex flex-col gap-xs">
                    <label class="font-label-sm uppercase">Email Address</label>
                    <input name="email" type="email" placeholder="priya@example.com"
                        class="w-full bg-surface-container-low border border-outline-variant/30 rounded-full px-md py-sm focus:outline-none focus:ring-2 focus:ring-primary"
                        required />
                </div>
                <div class="flex flex-col gap-xs">
                    <label class="font-label-sm uppercase">I am a...</label>
                    <div class="flex gap-sm">
                        <label class="flex-1 flex items-center justify-center gap-xs border-2 border-outline-variant/30 rounded-full py-sm cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/10 transition-all">
                            <input type="radio" name="role" value="customer" class="hidden" required /> 🍽️ Customer
                        </label>
                        <label class="flex-1 flex items-center justify-center gap-xs border-2 border-outline-variant/30 rounded-full py-sm cursor-pointer has-[:checked]:border-primary has-[:checked]:bg-primary/10 transition-all">
                            <input type="radio" name="role" value="chef" class="hidden" /> 👨‍🍳 Home Chef
                        </label>
                    </div>
                </div>
                <button type="submit"
                    class="w-full bg-primary text-on-primary py-md rounded-full font-h3 transition-transform hover:scale-[1.02] active:scale-95">
                    Count Me In! 🎉
                </button>
                <div id="waitlistSuccess" class="hidden text-center py-sm px-md bg-green-100 text-green-800 rounded-xl font-body-md">
                    🎊 You're on the list! We'll be in touch soon.
                </div>
            </form>
        </div>
    </div>
 
    <!-- ============================================================
         WHATSAPP FLOATING ACTION BUTTON
    ============================================================ -->
    <a href="https://wa.me/919999999999?text=Hi%20Ruchi%20Rush!%20I%20have%20a%20question."
       target="_blank"
       id="whatsappFab"
       title="Chat with us on WhatsApp"
       class="fixed bottom-6 right-6 z-[9998] w-14 h-14 rounded-full bg-[#25D366] flex items-center justify-center shadow-lg transition-transform hover:scale-110 active:scale-95"
       style="box-shadow: 0 4px 20px rgba(37,211,102,0.5)">
        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
